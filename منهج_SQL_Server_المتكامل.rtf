{\rtf1\ansi\deff0{\fonttbl{\f0\fnil Arial;}}\viewkind4\uc1\pard\lang1033\f0\fs28\b\qc\par\pard\sa200\sl276\fi0\qj\f0\fs24\b\par منهج SQL Server المتكامل لتدريس الطلاب\par\b0\par ------------------------------------------------------------------------------\par\par \b 1. مقدمة عن المنهج\b0\par\par هذا المنهج مصمم لتعليم الطلاب أساسيات ومفاهيم SQL Server بشكل تدريجي ومنظم، بدءاً من المفاهيم الأساسية في قواعد البيانات وصولاً إلى الاستعلامات المتقدمة، مع تطبيق عملي على منظومة المدرسة.\par\par يهدف المنهج إلى تمكين الطالب من: \par - فهم أساسيات قواعد البيانات\par - إنشاء قواعد بيانات وجداول\par - كتابة استعلامات SQL\par - التعامل مع العلاقات بين الجداول\par - تنفيذ العمليات والتقارير\par - استخدام Stored Procedures و Views و Functions و Triggers\par - تحسين الأداء والأمان\par\par ------------------------------------------------------------------------------\par\par \b 2. أهداف المنهج\b0\par\par 1. فهم مبادئ قواعد البيانات وعملها\par 2. إنشاء قاعدة بيانات SQL Server\par 3. تصميم الجداول والعلاقات\par 4. كتابة استعلامات SELECT و WHERE و ORDER BY\par 5. استخدام JOIN و GROUP BY\par 6. استخدام Subquery و EXISTS و CASE\par 7. تنفيذ INSERT و UPDATE و DELETE\par 8. إنشاء Views و Procedures و Functions\par 9. إدارة الأمان والأداء\par 10. تنفيذ مشروع عملي على منظومة المدرسة\par\par ------------------------------------------------------------------------------\par\par \b 3. مدة المنهج\b0\par\par - المدة المتوقعة: 12 إلى 16 أسبوعاً\par - عدد الحصص: 2 حصص أسبوعياً\par - تمرين عملي: كل أسبوع\par - مشروع نهائي: في نهاية المنهج\par\par ------------------------------------------------------------------------------\par\par \b 4. هيكل المنهج\b0\par\par \b الوحدة الأولى: مقدمة لقواعد البيانات و SQL Server\b0\par - مفهوم قاعدة البيانات\par - أنواع قواعد البيانات\par - ما هي SQL؟\par - ما هو SQL Server؟\par - بيئة SSMS\par - إنشاء قاعدة بيانات جديدة\par - أنواع البيانات\par - القيود (Constraints)\par - المفتاح الأساسي PK\par - المفتاح الخارجي FK\par\par \b الوحدة الثانية: تصميم قاعدة البيانات\b0\par - ERD\par - One-to-One\par - One-to-Many\par - Many-to-Many\par - Normalization\par - العلاقة بين الطلاب والمواد والفصول والمدرسين\par\par \b الوحدة الثالثة: أساسيات SQL\b0\par - SELECT\par - FROM\par - WHERE\par - ORDER BY\par - DISTINCT\par - LIKE\par - IN\par - BETWEEN\par - AND / OR\par - TOP\par\par \b الوحدة الرابعة: الوظائف التجميعية\b0\par - COUNT\par - SUM\par - AVG\par - MIN\par - MAX\par - GROUP BY\par - HAVING\par\par \b الوحدة الخامسة: الانضمام بين الجداول\b0\par - INNER JOIN\par - LEFT JOIN\par - RIGHT JOIN\par - FULL JOIN\par - CROSS JOIN\par - SELF JOIN\par\par \b الوحدة السادسة: استعلامات متقدمة\b0\par - Subquery\par - EXISTS\par - CASE WHEN\par - UNION و UNION ALL\par - CTE\par\par \b الوحدة السابعة: إدراج وتحديث وحذف البيانات\b0\par - INSERT\par - UPDATE\par - DELETE\par - TRUNCATE\par - MERGE\par\par \b الوحدة الثامنة: Views\b0\par - مفهوم View\par - إنشاء View\par - استخدام View في التقارير\par\par \b الوحدة التاسعة: Stored Procedures\b0\par - مفهوم Procedure\par - Parameters\par - إجراء إضافة/تحديث/حذف\par\par \b الوحدة العاشرة: Functions\b0\par - Scalar Function\par - Table-valued Function\par\par \b الوحدة الحادية عشرة: Triggers\b0\par - AFTER INSERT\par - AFTER UPDATE\par - AFTER DELETE\par - استخدامات المشغلات\par\par \b الوحدة الثانية عشرة: الأمان والأداء\b0\par - Indexes\par - Execution Plan\par - Permissions\par - GRANT و REVOKE\par\par ------------------------------------------------------------------------------\par\par \b 5. قاعدة بيانات المدرسة\b0\par\par \b الجداول الأساسية\b0\par\par 1. Class\par - Class_ID\par - Class_Name\par - Level\par\par 2. Student\par - Student_ID\par - Name\par - BirthDate\par - Gender\par - Address\par - Class_ID\par\par 3. Teacher\par - Teacher_ID\par - Name\par - Specialization\par - Phone\par\par 4. Subject\par - Subject_ID\par - Subject_Name\par - Grade\par - Teacher_ID\par\par 5. Registration\par - Student_ID\par - Subject_ID\par - Registration_Date\par\par 6. Teaches_Student\par - Teaches_Student_ID\par - Teacher_ID\par - Student_ID\par\par \b العلاقات\b0\par - كل طالب ينتمي إلى صف واحد\par - كل صف يحتوي على عدة طلاب\par - كل مادة يدرّسها مدرس واحد\par - كل طالب يسجل في عدة مواد\par - كل مادة مسجلة لعدة طلاب\par - كل مدرس يدرّس عدة طلاب\par\par ------------------------------------------------------------------------------\par\par \b 6. إنشاء قاعدة البيانات\b0\par\par \b SQL\b0\par\par CREATE DATABASE SchoolDB;\par GO\par\par USE SchoolDB;\par GO\par\par CREATE TABLE Class (\par    Class_ID INT PRIMARY KEY IDENTITY(1,1),\par    Class_Name NVARCHAR(100) NOT NULL,\par    Level NVARCHAR(50) NOT NULL\par );\par\par CREATE TABLE Student (\par    Student_ID INT PRIMARY KEY IDENTITY(1,1),\par    Name NVARCHAR(100) NOT NULL,\par    BirthDate DATE NOT NULL,\par    Gender NVARCHAR(10) CHECK (Gender IN ('Male','Female')),\par    Address NVARCHAR(255),\par    Class_ID INT NOT NULL,\par    CONSTRAINT FK_Student_Class FOREIGN KEY (Class_ID)\par        REFERENCES Class(Class_ID)\par );\par\par CREATE TABLE Teacher (\par    Teacher_ID INT PRIMARY KEY IDENTITY(1,1),\par    Name NVARCHAR(100) NOT NULL,\par    Specialization NVARCHAR(100),\par    Phone NVARCHAR(20)\par );\par\par CREATE TABLE Subject (\par    Subject_ID INT PRIMARY KEY IDENTITY(1,1),\par    Subject_Name NVARCHAR(100) NOT NULL,\par    Grade NVARCHAR(20) NOT NULL,\par    Teacher_ID INT NOT NULL,\par    CONSTRAINT FK_Subject_Teacher FOREIGN KEY (Teacher_ID)\par        REFERENCES Teacher(Teacher_ID)\par );\par\par CREATE TABLE Registration (\par    Student_ID INT NOT NULL,\par    Subject_ID INT NOT NULL,\par    Registration_Date DATE NOT NULL,\par    CONSTRAINT PK_Registration PRIMARY KEY (Student_ID, Subject_ID),\par    CONSTRAINT FK_Registration_Student FOREIGN KEY (Student_ID)\par        REFERENCES Student(Student_ID),\par    CONSTRAINT FK_Registration_Subject FOREIGN KEY (Subject_ID)\par        REFERENCES Subject(Subject_ID)\par );\par\par CREATE TABLE Teaches_Student (\par    Teaches_Student_ID INT PRIMARY KEY IDENTITY(1,1),\par    Teacher_ID INT NOT NULL,\par    Student_ID INT NOT NULL,\par    CONSTRAINT FK_Teaches_Student_Teacher FOREIGN KEY (Teacher_ID)\par        REFERENCES Teacher(Teacher_ID),\par    CONSTRAINT FK_Teaches_Student_Student FOREIGN KEY (Student_ID)\par        REFERENCES Student(Student_ID)\par );\par\par ------------------------------------------------------------------------------\par\par \b 7. إدراج بيانات تجريبية\b0\par\par INSERT INTO Class (Class_Name, Level)\par VALUES\par ('A1', 'Primary'),\par ('B2', 'Middle'),\par ('C3', 'Secondary');\par\par INSERT INTO Student (Name, BirthDate, Gender, Address, Class_ID)\par VALUES\par ('Ali Ahmed', '2012-05-10', 'Male', 'Riyadh', 1),\par ('Sara Khaled', '2011-08-14', 'Female', 'Jeddah', 1),\par ('Mohammed Saleh', '2010-02-20', 'Male', 'Dammam', 2),\par ('Layla Hassan', '2009-11-15', 'Female', 'Makkah', 2),\par ('Omar Nasser', '2008-07-05', 'Male', 'Abha', 3),\par ('Noura Salem', '2007-06-18', 'Female', 'Tabuk', 3);\par\par INSERT INTO Teacher (Name, Specialization, Phone)\par VALUES\par ('Mr. Abdullah', 'Mathematics', '0551111111'),\par ('Mrs. Huda', 'Science', '0552222222'),\par ('Mr. Faisal', 'Arabic', '0553333333'),\par ('Mrs. Noor', 'English', '0554444444');\par\par INSERT INTO Subject (Subject_Name, Grade, Teacher_ID)\par VALUES\par ('Mathematics', 'A', 1),\par ('Science', 'B', 2),\par ('Arabic', 'A', 3),\par ('English', 'B', 4);\par\par INSERT INTO Registration (Student_ID, Subject_ID, Registration_Date)\par VALUES\par (1, 1, '2025-09-01'),\par (1, 2, '2025-09-01'),\par (2, 3, '2025-09-02'),\par (2, 4, '2025-09-02'),\par (3, 1, '2025-09-03'),\par (3, 2, '2025-09-03'),\par (4, 3, '2025-09-04'),\par (5, 4, '2025-09-05'),\par (6, 1, '2025-09-05'),\par (6, 2, '2025-09-05');\par\par INSERT INTO Teaches_Student (Teacher_ID, Student_ID)\par VALUES\par (1, 1),\par (1, 3),\par (1, 6),\par (2, 1),\par (2, 4),\par (3, 2),\par (3, 4),\par (4, 2),\par (4, 5),\par (4, 6);\par\par ------------------------------------------------------------------------------\par\par \b 8. الاستعلامات الأساسية\b0\par\par SELECT * FROM Student;\par\par SELECT s.Student_ID, s.Name, c.Class_Name\par FROM Student s\par INNER JOIN Class c ON s.Class_ID = c.Class_ID;\par\par SELECT sub.Subject_Name, t.Name AS Teacher_Name\par FROM Subject sub\par INNER JOIN Teacher t ON sub.Teacher_ID = t.Teacher_ID;\par\par SELECT s.Name, sub.Subject_Name, r.Registration_Date\par FROM Registration r\par INNER JOIN Student s ON r.Student_ID = s.Student_ID\par INNER JOIN Subject sub ON r.Subject_ID = sub.Subject_ID;\par\par ------------------------------------------------------------------------------\par\par \b 9. الاستعلامات المتقدمة\b0\par\par SELECT c.Class_Name, COUNT(s.Student_ID) AS Student_Count\par FROM Class c\par LEFT JOIN Student s ON c.Class_ID = s.Class_ID\par GROUP BY c.Class_Name;\par\par SELECT t.Name, COUNT(sub.Subject_ID) AS Subject_Count\par FROM Teacher t\par LEFT JOIN Subject sub ON t.Teacher_ID = sub.Teacher_ID\par GROUP BY t.Name;\par\par SELECT TOP 1 s.Name, COUNT(r.Subject_ID) AS Number_Of_Subjects\par FROM Student s\par JOIN Registration r ON s.Student_ID = r.Student_ID\par GROUP BY s.Name\par ORDER BY Number_Of_Subjects DESC;\par\par ------------------------------------------------------------------------------\par\par \b 10. View\b0\par\par CREATE VIEW vw_Student_Class AS\par SELECT s.Student_ID, s.Name AS Student_Name, c.Class_Name, c.Level\par FROM Student s\par JOIN Class c ON s.Class_ID = c.Class_ID;\par GO\par\par SELECT * FROM vw_Student_Class;\par\par ------------------------------------------------------------------------------\par\par \b 11. Stored Procedure\b0\par\par CREATE PROCEDURE sp_AddStudent\par    @Name NVARCHAR(100),\par    @BirthDate DATE,\par    @Gender NVARCHAR(10),\par    @Address NVARCHAR(255),\par    @Class_ID INT\par AS\par BEGIN\par    INSERT INTO Student (Name, BirthDate, Gender, Address, Class_ID)\par    VALUES (@Name, @BirthDate, @Gender, @Address, @Class_ID);\par END;\par GO\par\par EXEC sp_AddStudent 'Hassan Ali', '2013-01-10', 'Male', 'Jazan', 1;\par\par ------------------------------------------------------------------------------\par\par \b 12. Function\b0\par\par CREATE FUNCTION fn_CountStudentsInClass(@Class_ID INT)\par RETURNS INT\par AS\par BEGIN\par    DECLARE @Count INT;\par    SELECT @Count = COUNT(*)\par    FROM Student\par    WHERE Class_ID = @Class_ID;\par    RETURN @Count;\par END;\par GO\par\par SELECT dbo.fn_CountStudentsInClass(1) AS Student_Count;\par\par ------------------------------------------------------------------------------\par\par \b 13. Trigger\b0\par\par CREATE TRIGGER trg_StudentAudit\par ON Student\par AFTER INSERT\par AS\par BEGIN\par    PRINT 'New student added';\par END;\par GO\par\par ------------------------------------------------------------------------------\par\par \b 14. Indexes و الأداء\b0\par\par CREATE INDEX IX_Student_ClassID ON Student(Class_ID);\par GO\par\par SELECT * FROM Student WHERE Class_ID = 1;\par\par ------------------------------------------------------------------------------\par\par \b 15. تمارين تطبيقية\b0\par\par 1. أوجد أسماء جميع الطلاب\par 2. أوجد الطلاب في الصف الأول\par 3. أوجد عدد الطلاب في كل صف\par 4. أوجد المواد التي يدرّسها كل معلم\par 5. أوجد الطالب الذي يدرس أكثر من مادة\par 6. أوجد الطلاب الذين يدرّسهم مدرس محدد\par 7. أنشئ View يوضح كل طالب مع الصف\par 8. أنشئ Procedure لإضافة طالب جديد\par 9. أنشئ Function لحساب عدد الطلاب في صف معين\par 10. أضف Trigger لتسجيل إضافة طالب\par\par ------------------------------------------------------------------------------\par\par \b 16. تقييم الطلبة\b0\par\par - اختبار نظري: 20%\par - اختبار عملي: 30%\par - مشاريع: 30%\par - حضور ومشاركة: 20%\par\par ------------------------------------------------------------------------------\par\par \b 17. الخلاصة\b0\par\par هذا المنهج مناسب للطلاب المبتدئين والمتوسطين، ويعتمد على تطبيق عملي حقيقي على منظومة المدرسة.\par\par من خلال هذا المنهج، يتعلم الطالب:\par - بناء قواعد البيانات\par - كتابة الاستعلامات\par - تصميم العلاقات\par - التعامل مع SQL Server\par - إعداد تقارير واستعلامات عملية\par - تنفيذ مشروع كامل\par\par ------------------------------------------------------------------------------\par\par \b 18. ملاحظة للمعلم\b0\par\par يمكن زيادة محتوى المنهج بإضافة: \par - Attendance\par - Exams\par - Result\par - Fees\par - Parents\par - Employees\par - Login System\par\par هذا يعزّز المشروع ويجعله أكثر قرباً من النظام المدرسي الحقيقي.\par\par \b 19. نصيحة عملية\b0\par\par يفضل أن يطبق كل طالب كل درس على قاعدة البيانات نفسها، بحيث يلاحظ التحسن خطوة بخطوة ويصبح المشروع النهائي جاهزاً للتقديم.\par\par \b 20. نهاية الوثيقة\b0\par\par \pard\qc\par\fs26\b تم إعداد هذا المنهج لتعليم SQL Server بشكل عملي ومتكامل على منظومة المدرسة.\par\par\b0\fs24\par }